# Entorno: nunca se suben credenciales
.env
.env.local
*.env
!.env.example

# Go
backend/api
backend/bin/

# Node
node_modules/
frontend/dist/
*.log

# La interfaz compilada se incrusta en el binario, pero se genera en cada
# build: solo se versiona el directorio, para que go:embed no falle.
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep
